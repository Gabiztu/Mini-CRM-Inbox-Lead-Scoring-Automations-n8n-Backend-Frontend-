      "parameters": {
        "url": "http://localhost:4000/api/leads",
        "options": {},
        "queryParameters": {
          "parameter": [
            {
              "name": "search",
              "value": "={{ $('Webhook').item.json.body.user }}"
            }
          ]
        }
      },
      "id": "get-lead-node",
      "name": "Get Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [680, 460],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Normalize Backend Response\nconst data = items[0].json;\n\nif (Array.isArray(data)) {\n  return data.length > 0 ? [{json: data[0]}] : [{json: {}}];\n}\n\nif (data.items && Array.isArray(data.items)) {\n  return data.items.length > 0 ? [{json: data.items[0]}] : [{json: {}}];\n}\n\nreturn items;"
      },
      "id": "normalize-node",
      "name": "Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 460]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.id }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "check-exists-node",
      "name": "Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1120, 460]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:4000/api/leads",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  name: $('Webhook').item.json.body.user,\n  email: $('Webhook').item.json.body.user.includes('@') ? $('Webhook').item.json.body.user : $('Webhook').item.json.body.user + '@example.com',\n  source: 'Inbound Webhook'\n}) }}",
        "options": {}
      },
      "id": "create-lead-node",
      "name": "Create Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1340, 580]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "leadId",
              "value": "={{ $json.id }}"
            },
            {
              "name": "message",
              "value": "={{ $('Webhook').item.json.body.message }}"
            },
            {
              "name": "timestamp",
              "value": "={{ $('Webhook').item.json.body.timestamp }}"
            }
          ]
        },
        "options": {}
      },
      "id": "set-payload-node",
      "name": "Set Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [1560, 460]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:4000/api/messages",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  leadId: $json.leadId,\n  content: $json.message,\n  direction: 'INBOUND',\n  timestamp: $json.timestamp\n}) }}",
        "options": {}
      },
      "id": "log-message-node",
      "name": "Log Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1780, 460]
    },
    {
      "parameters": {
        "jsCode": "// FIX: Read directly from Webhook to avoid 'undefined' error\nconst message = $('Webhook').item.json.body.message.toLowerCase();\n\n// FIX: Read leadId from previous node (which is the Message object from API)\n// The API returns { id: 'msg_...', leadId: 'lead_...', content: '...' }\nconst leadId = $json.leadId;\n\nlet scoreDelta = 0;\n\n// Scoring Logic\nif (message.includes('buy') || message.includes('urgent')) {\n  scoreDelta += 20;\n} else if (message.includes('interested') || message.includes('demo')) {\n  scoreDelta += 10;\n}\n\nif (message.includes('unsubscribe') || message.includes('remove')) {\n  scoreDelta -= 10;\n}\n\nlet newStatus = undefined;\nif (scoreDelta > 30) newStatus = 'QUALIFIED';\n\nreturn {\n  json: {\n    leadId,\n    score: scoreDelta,\n    status: newStatus\n  }\n};"
      },
      "id": "calc-score-node",
      "name": "Calc Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 460]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "={{ 'http://localhost:4000/api/leads/' + $json.leadId }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  score: $json.score,\n  ...( $json.status ? { status: $json.status } : {} )\n}) }}",
        "options": {}
      },
      "id": "update-lead-node",
      "name": "Update Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [2220, 460]
    }
  ],
