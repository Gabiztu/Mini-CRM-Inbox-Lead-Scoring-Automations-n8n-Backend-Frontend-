        "jsonBody": "={{ JSON.stringify({\n  leadId: $json.leadId,\n  content: $json.message,\n  direction: 'INBOUND',\n  timestamp: $json.timestamp\n}) }}",
        "options": {}
      },
      "id": "e0f712c3-ca44-4c72-9f76-5c57a2619544",
      "name": "Log Message",
      "type": "n8n-nodes-base.httpRequest",
