      "typeVersion": 2,
      "position": [1420, 320]
    },
    {
      "parameters": {
        "url": "http://localhost:4000/api/messages",
        "options": {},
        "sendBody": true,
        "jsonParameters": true,
        "bodyParametersJson": "{\n  \"leadId\": \"={{$json.leadId}}\",\n  \"content\": \"={{$json.message}}\",\n  \"direction\": \"INBOUND\"\n}"
      },
      "id": "Create Message",
      "name": "Create Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1640, 320]
    },
    {
      "parameters": {
        "url": "http://localhost:4000/api/leads/{{$json.leadId}}",
        "options": {}
      },
      "id": "Get Lead By Id",
      "name": "Get Lead By Id",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1860, 320]
    },
    {
      "parameters": {
        "functionCode": "const text = ($prevNode['Webhook'].json.message || '').toLowerCase();\nlet scoreDelta = 0;\nif (text.includes('buy') || text.includes('contract') || text.includes('urgent')) scoreDelta += 20;\nif (text.includes('interested') || text.includes('demo') || text.includes('pricing')) scoreDelta += 10;\nif (text.includes('unsubscribe') || text.includes('remove') || text.includes('no thanks')) scoreDelta -= 10;\nreturn [{ json: { scoreDelta, currentScore: $json.score, leadId: $json.id } }];"
      },
      "id": "Calc Score",
      "name": "Calc Score",
      "type": "n8n-nodes-base.function",
      "typeVersion": 2,
      "position": [2080, 320]
    },
    {
      "parameters": {
        "url": "http://localhost:4000/api/leads/{{$json.leadId}}",
        "options": {},
        "sendBody": true,
        "jsonParameters": true,
        "bodyParametersJson": "={{ (() => { const newScore = ($json.currentScore || 0) + ($json.scoreDelta || 0); const body = { score: newScore }; if (newScore > 40) body.status = 'QUALIFIED'; return JSON.stringify(body); })() }}"
      },
      "id": "Update Lead",
      "name": "Update Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [2300, 320]
    }
  ],
