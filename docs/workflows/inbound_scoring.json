        "jsCode": "// Normalize Backend Response\nconst data = items[0].json;\n\nif (Array.isArray(data)) {\n  return data.length > 0 ? [{json: data[0]}] : [{json: {}}];\n}\n\nif (data.items && Array.isArray(data.items)) {\n  return data.items.length > 0 ? [{json: data.items[0]}] : [{json: {}}];\n}\n\nreturn items;"
      },
