    },
    {
      "parameters": {
        "jsCode": "// Robustly read lead data (handle n8n version diffs)\nconst lead = $json.body || $json;\n\n// Safely read message from Webhook\nconst message = (($('Webhook').item.json.body?.message) || '').toLowerCase();\n\nlet scoreDelta = 0;\n\n// Define Keyword Arrays\nconst plus20 = ['buy', 'contract', 'urgent'];\nconst plus10 = ['interested', 'demo', 'pricing'];\nconst minus10 = ['unsubscribe', 'remove', 'no thanks'];\n\n// Calculate Score\nfor (const w of plus20) if (message.includes(w)) scoreDelta += 20;\nfor (const w of plus10) if (message.includes(w)) scoreDelta += 10;\nfor (const w of minus10) if (message.includes(w)) scoreDelta -= 10;\n\n// Determine New Score\nconst newScore = (lead.score || 0) + scoreDelta;\n\n// Determine New Status\nlet newStatus = undefined;\n// Only change status if it qualifies and isn't already in a terminal state\nif (newScore > 40 && lead.status !== 'WON' && lead.status !== 'LOST') {\n  newStatus = 'QUALIFIED';\n}\n\nreturn {\n  json: {\n    leadId: lead.id,\n    newScore,\n    newStatus,\n    scoreDelta\n  }\n};\n"
      },
      "id": "944e64ef-aeb6-4da4-9102-45ab52f91715",
      "name": "Calc Score",
      "type": "n8n-nodes-base.code",
